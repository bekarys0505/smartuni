generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  email          String          @unique
  phone          String?         @unique
  passwordHash   String
  role           UserRole        @default(STUDENT)
  status         UserStatus      @default(ACTIVE)
  emailVerified  Boolean         @default(false)
  phoneVerified  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdGroups  Group[]         @relation("GroupCreatedBy")
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  @@index([role])
  @@index([status])
}

model University {
  id        String           @id @default(uuid())
  name      String           @unique
  shortName String?
  createdAt DateTime         @default(now())
  faculties Faculty[]
  students  StudentProfile[]
  teachers  TeacherProfile[]
}

model Faculty {
  id           String           @id @default(uuid())
  name         String
  universityId String
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  majors       Major[]
  students     StudentProfile[]
  teachers     TeacherProfile[]

  @@unique([universityId, name])
  @@index([universityId])
}

model Major {
  id        String           @id @default(uuid())
  name      String
  facultyId String
  faculty   Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students  StudentProfile[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

model StudentProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  universityId String
  facultyId    String
  majorId      String
  course       Int
  avatarUrl    String?
  premium      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  GroupMembership[]
  joinRequests JoinRequest[]
  faculty      Faculty           @relation(fields: [facultyId], references: [id])
  major        Major             @relation(fields: [majorId], references: [id])
  university   University        @relation(fields: [universityId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  universityId String
  facultyId    String
  department   String?
  position     String?
  experience   Int?
  avatarUrl    String?
  bio          String?
  premium      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  groups       Group[]
  faculty      Faculty    @relation(fields: [facultyId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[]

  @@index([name])
}

model Group {
  id           String            @id @default(uuid())
  name         String
  subjectId    String
  teacherId    String
  course       Int
  capacity     Int               @default(30)
  semester     Int
  academicYear String
  lessonDay    String?
  lessonTime   String?
  classroom    String?
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdById  String?
  createdBy    User?             @relation("GroupCreatedBy", fields: [createdById], references: [id])
  subject      Subject           @relation(fields: [subjectId], references: [id])
  teacher      TeacherProfile    @relation(fields: [teacherId], references: [id])
  memberships  GroupMembership[]
  joinRequests JoinRequest[]

  @@index([subjectId])
  @@index([teacherId])
  @@index([course])
}

model GroupMembership {
  id        String                @id @default(uuid())
  studentId String
  groupId   String
  status    GroupMembershipStatus @default(ACTIVE)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?
  group     Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

model JoinRequest {
  id          String         @id @default(uuid())
  studentId   String
  groupId     String
  status      RequestStatus  @default(PENDING)
  createdAt   DateTime       @default(now())
  respondedAt DateTime?
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([groupId, status])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupMembershipStatus {
  ACTIVE
  LEFT
}
