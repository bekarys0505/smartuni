generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupMembershipStatus {
  ACTIVE
  LEFT
}

enum MaterialType {
  LECTURE
  VIDEO
  ADDITIONAL_RESOURCE
}

enum ProgressStatus {
  UNREAD
  STARTED
  COMPLETED
}

enum AssignmentResponseType {
  TEXT
  FILE
  TEXT_AND_FILE
}

enum AssignmentSubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  GRADED
  LATE
}

enum TestQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_TEXT
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  email          String          @unique
  phone          String?         @unique
  passwordHash   String
  role           UserRole        @default(STUDENT)
  status         UserStatus      @default(ACTIVE)
  emailVerified  Boolean         @default(false)
  phoneVerified  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  createdGroups  Group[]         @relation("GroupCreatedBy")

  @@index([role])
  @@index([status])
}

model University {
  id        String           @id @default(uuid())
  name      String           @unique
  shortName String?
  createdAt DateTime         @default(now())
  faculties Faculty[]
  students  StudentProfile[]
  teachers  TeacherProfile[]
}

model Faculty {
  id           String           @id @default(uuid())
  name         String
  universityId String
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  majors       Major[]
  students     StudentProfile[]
  teachers     TeacherProfile[]

  @@unique([universityId, name])
  @@index([universityId])
}

model Major {
  id        String           @id @default(uuid())
  name      String
  facultyId String
  faculty   Faculty          @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students  StudentProfile[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

model StudentProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  universityId String
  facultyId    String
  majorId      String
  course       Int
  avatarUrl    String?
  premium      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University        @relation(fields: [universityId], references: [id])
  faculty      Faculty           @relation(fields: [facultyId], references: [id])
  major        Major             @relation(fields: [majorId], references: [id])
  memberships           GroupMembership[]
  joinRequests          JoinRequest[]
  materialProgresses    StudentMaterialProgress[]
  assignmentSubmissions AssignmentSubmission[]
  testAttempts          TestAttempt[]
  attendanceRecords     AttendanceRecord[]
  termGrades            TermGrade[]
}

model TeacherProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  universityId String
  facultyId    String
  department   String?
  position     String?
  experience   Int?
  avatarUrl    String?
  bio          String?
  premium      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id])
  faculty      Faculty    @relation(fields: [facultyId], references: [id])
  groups       Group[]
  tests        Test[]
  markedAttendances AttendanceRecord[]
  markedTermGrades  TermGrade[]
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[]
  topics      Topic[]
  tests       Test[]
  termGrades  TermGrade[]

  @@index([name])
}

model Group {
  id           String            @id @default(uuid())
  name         String
  subjectId    String
  teacherId    String
  course       Int
  capacity     Int               @default(30)
  semester     Int
  academicYear String
  lessonDay    String?
  lessonTime   String?
  classroom    String?
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdById  String?
  subject      Subject           @relation(fields: [subjectId], references: [id])
  teacher      TeacherProfile    @relation(fields: [teacherId], references: [id])
  createdBy    User?             @relation("GroupCreatedBy", fields: [createdById], references: [id])
  memberships       GroupMembership[]
  joinRequests      JoinRequest[]
  attendanceRecords AttendanceRecord[]
  termGrades        TermGrade[]

  @@index([subjectId])
  @@index([teacherId])
  @@index([course])
}

model GroupMembership {
  id        String                @id @default(uuid())
  studentId String
  groupId   String
  status    GroupMembershipStatus @default(ACTIVE)
  joinedAt  DateTime              @default(now())
  leftAt    DateTime?
  student   StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

model JoinRequest {
  id          String         @id @default(uuid())
  studentId   String
  groupId     String
  status      RequestStatus  @default(PENDING)
  createdAt   DateTime       @default(now())
  respondedAt DateTime?
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([groupId, status])
}

model Topic {
  id          String       @id @default(uuid())
  subjectId   String
  title       String
  description String?
  order       Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials   Material[]
  assignments Assignment[]
  tests       Test[]

  @@index([subjectId])
  @@index([order])
}

model Material {
  id          String                    @id @default(uuid())
  topicId     String
  title       String
  description String?
  type        MaterialType              @default(LECTURE)
  contentUrl  String?
  contentText String?
  order       Int                       @default(1)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  topic       Topic                     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses  StudentMaterialProgress[]

  @@index([topicId])
  @@index([order])
}

model StudentMaterialProgress {
  id          String         @id @default(uuid())
  studentId   String
  materialId  String
  status      ProgressStatus @default(UNREAD)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([studentId])
  @@index([materialId])
  @@index([status])
}

model Assignment {
  id            String                 @id @default(uuid())
  topicId       String
  title         String
  description   String?
  responseType  AssignmentResponseType @default(TEXT)
  attachmentUrl String?
  maxScore      Int                    @default(100)
  assignedAt    DateTime               @default(now())
  deadline      DateTime?
  allowLate     Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  topic       Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([topicId])
  @@index([deadline])
}

model AssignmentSubmission {
  id             String                     @id @default(uuid())
  assignmentId   String
  studentId      String
  textAnswer     String?
  fileUrl        String?
  status         AssignmentSubmissionStatus @default(NOT_SUBMITTED)
  submittedAt    DateTime?
  score          Int?
  teacherComment String?
  gradedAt       DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model Test {
  id                        String          @id @default(uuid())
  subjectId                 String
  topicId                   String?
  title                     String
  description               String?
  durationMinutes           Int             @default(15)
  maxScore                  Int             @default(100)
  status                    TestStatus      @default(DRAFT)
  scheduledAt               DateTime?
  shuffleQuestions          Boolean         @default(false)
  shuffleAnswers            Boolean         @default(false)
  showResultsImmediately    Boolean         @default(true)
  createdByTeacherProfileId String
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic           Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  teacherProfile  TeacherProfile  @relation(fields: [createdByTeacherProfileId], references: [id], onDelete: Cascade)
  questions       TestQuestion[]
  attempts        TestAttempt[]

  @@index([subjectId])
  @@index([topicId])
  @@index([createdByTeacherProfileId])
  @@index([status])
  @@index([scheduledAt])
}

model TestQuestion {
  id           String           @id @default(uuid())
  testId       String
  type         TestQuestionType @default(SINGLE_CHOICE)
  questionText String
  order        Int              @default(1)
  points       Int              @default(1)
  explanation  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  test         Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  options      TestOption[]
  answers      TestAnswer[]

  @@index([testId])
  @@index([order])
}

model TestOption {
  id         String       @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean      @default(false)
  order      Int          @default(1)

  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([order])
}

model TestAttempt {
  id               String            @id @default(uuid())
  testId           String
  studentProfileId String
  status           TestAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime          @default(now())
  submittedAt      DateTime?
  expiresAt        DateTime
  score            Float?
  percentage       Float?
  correctAnswers   Int               @default(0)
  totalQuestions   Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  test             Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  student          StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers          TestAnswer[]

  @@index([testId])
  @@index([studentProfileId])
  @@index([status])
}

model TestAnswer {
  id                String       @id @default(uuid())
  attemptId         String
  questionId        String
  textAnswer        String?
  selectedOptionIds String?
  isCorrect         Boolean?
  score             Float?
  teacherComment    String?
  answeredAt        DateTime     @default(now())

  attempt           TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  studentId         String
  groupId           String
  date              DateTime         @db.Date
  status            AttendanceStatus @default(PRESENT)
  markedByTeacherId String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group             Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  markedBy          TeacherProfile?  @relation(fields: [markedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId, date])
  @@index([groupId, date])
  @@index([studentId, date])
}

model TermGrade {
  id                String          @id @default(uuid())
  studentId         String
  groupId           String
  subjectId         String
  rk1               Float?
  rk2               Float?
  session           Float?
  note              String?
  markedByTeacherId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group             Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  markedBy          TeacherProfile? @relation(fields: [markedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId])
  @@index([groupId])
  @@index([studentId])
  @@index([subjectId])
}


